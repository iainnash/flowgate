{
  "$schema": "./safe-tools.schema.json",
  "version": 1,

  "categories": {
    "read": {
      "description": "Read-only tools that don't modify files or system state",
      "autoApprove": true,
      "tools": [
        "Read",
        "Glob",
        "Grep",
        "WebFetch",
        "WebSearch",
        "ListMcpResourcesTool",
        "ReadMcpResourceTool",
        "TaskList",
        "TaskGet"
      ]
    },
    "write": {
      "description": "Tools that modify files",
      "autoApprove": false,
      "tools": [
        "Edit",
        "Write",
        "NotebookEdit"
      ]
    },
    "execute": {
      "description": "Tools that execute commands or spawn processes",
      "autoApprove": false,
      "tools": [
        "Bash",
        "Task"
      ]
    },
    "other": {
      "description": "Other tools not categorized above",
      "autoApprove": false,
      "tools": []
    }
  },

  "patterns": {
    "description": "Regex patterns for auto-approving specific tool inputs",
    "rules": [
      {
        "tool": "Bash",
        "field": "command",
        "pattern": "^(ls|pwd|echo|cat|head|tail|wc|date|whoami|hostname|uname|which|type|file|stat)\\b",
        "autoApprove": true,
        "note": "Safe read-only shell commands"
      },
      {
        "tool": "Bash",
        "field": "command",
        "pattern": "^git\\s+(status|log|diff|branch|show|remote|config\\s+--get)",
        "autoApprove": true,
        "note": "Safe read-only git commands"
      },
      {
        "tool": "Bash",
        "field": "command",
        "pattern": "^(npm|pnpm|yarn)\\s+(list|ls|info|view|show|outdated|audit)",
        "autoApprove": true,
        "note": "Safe read-only package manager commands"
      }
    ]
  },

  "learned": {
    "description": "Commands approved by user with 'always allow'",
    "commands": []
  }
}
