{
  "name": "flowgate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"./scripts/dev-server.sh\" \"pnpm --filter ui dev\"",
    "dev:server": "./scripts/dev-server.sh",
    "dev:stream-deck": "pnpm --filter stream-deck-client dev",
    "build": "pnpm --filter ui build && cd go-server && go build -o claude-prompt-server && cd ../hooks && go build -o prompt-hook prompt-hook.go",
    "build:server": "cd go-server && go build -o claude-prompt-server",
    "build:hook": "cd hooks && go build -o prompt-hook prompt-hook.go",
    "build:stream-deck": "pnpm --filter stream-deck-client build",
    "build:app": "./scripts/build-app.sh",
    "test": "pnpm --filter ui test",
    "test:watch": "pnpm --filter ui test:watch"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "packageManager": "pnpm@10.19.0"
}
