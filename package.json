{
  "name": "claude-prompt-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"./scripts/dev-server.sh\" \"pnpm --filter ui dev\"",
    "dev:server": "./scripts/dev-server.sh",
    "dev:stream-deck": "pnpm --filter stream-deck-client dev",
    "build": "pnpm -r build && cd go-server && make build && cd ../hooks && make build",
    "build:server": "cd go-server && make build",
    "build:hook": "cd hooks && make build",
    "build:stream-deck": "pnpm --filter stream-deck-client build",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "test:e2e": "playwright test",
    "test:ci": "pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "concurrently": "^8.2.2"
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8"
}
